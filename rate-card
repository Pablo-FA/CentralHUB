/* ── dibujo ── */
function drawCanvas(){
  var g=pg(); ensureXY();
  var mx=0,my=0;
  g.nodes.forEach(function(n){ if(n.px>mx)mx=n.px; if(n.py>my)my=n.py });
  var vp=$("cvb"), vw=(vp.clientWidth||900)/Z(), vh=(vp.clientHeight||520)/Z();
  var W=Math.max(mx+NWC, vw)+Math.max(GX,480);
  var H=Math.max(my+340, vh)+420;
  var cards=g.nodes.map(function(n,idx){
    return "<div class='nd"+(EXP[n.id]?" op":"")+(SEL===n.id?" sel":"")+
      "' style='left:"+n.px+"px;top:"+n.py+"px' data-node='"+n.id+"'>"+ndInner(n,idx)+
      "<span class='port' data-port='"+n.id+"' title='Arrastra para conectar'></span></div>";
  }).join("");
