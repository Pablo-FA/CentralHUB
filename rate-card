    "<div class='cw' id='cw' style='width:"+W+"px;height:"+H+"px;transform:scale("+Z()+")'>"+
      "<svg id='cwsvg' width='"+W+"' height='"+H+"'><defs><marker id='ar' viewBox='0 0 8 8' refX='7' refY='4' "+
        "markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0 L8 4 L0 8 z' fill='currentColor'/>"+
        "</marker></defs><g id='cwg' color='var(--line2)'></g><path id='ghost' class='ed gh'/></svg>"+
      cards+"</div></div>";
