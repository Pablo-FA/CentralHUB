function rSum(g,r){ var t=0,any=false;
  LVL.forEach(function(l){var v=g[r][l]; if(v!=null){t+=v;any=true}});
  return any?Math.round(t*100)/100:null; }
function cSum(g,l){ var t=0,any=false;
  for(var r in g){var v=g[r][l]; if(v!=null){t+=v;any=true}}
  return any?Math.round(t*100)/100:null; }
function gSum(g){ var t=0,any=false;
  for(var r in g)LVL.forEach(function(l){var v=g[r][l]; if(v!=null){t+=v;any=true}});
  return any?Math.round(t*100)/100:null; }

