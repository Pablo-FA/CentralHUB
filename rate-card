<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>Tarifario · Command HUB</title>
<meta name="build-stamp" content="2026-09-30 10:57" data-file="rate-card"/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--grid:136px 1fr 152px 80px 100px 14px;--grid2:1fr 200px 86px 14px}
*{box-sizing:border-box}
:root{
  --bg:#f4f4f7; --surf:#fff; --surf2:#f8f8fb; --ink:#18182a; --mut:#4a4a6c; --fnt:#8888a8;
  --line:#e4e4ec; --line2:#c8c8dc; --acc:rgb(99,102,241); --acc-s:rgba(99,102,241,.08);
  --l12:#e0e1fc; --l11:#c3c5fa; --l10:#9da0f6; --l9:#6366f1; --l8:#4f46e5; --l7:#3730a3;
  --gate:#8888a8; --qual:#92400e; --qual-s:#fffbeb; --ok:#166534; --bad:#991b1b; --bad-s:#fef2f2;
  --sh:0 1px 3px rgba(0,0,0,.06),0 1px 2px rgba(0,0,0,.04);
  --shl:0 4px 12px rgba(0,0,0,.07),0 12px 40px rgba(0,0,0,.10);
  --r:8px;
}
[data-theme="dark"]{
    --bg:#0c0c14; --surf:#14141f; --surf2:#1c1c2a; --ink:#e2e2f0; --mut:#8888aa; --fnt:#6a6a88;
    --line:#26263a; --line2:#38385a; --acc:rgb(129,132,248); --acc-s:rgba(99,102,241,.14);
    --l12:#23244a; --l11:#34367a; --l10:#4b4eb0; --l9:#6366f1; --l8:#8184f8; --l7:#b4b6fc;
    --gate:#8888aa; --qual:#f0c060; --qual-s:#1e1508; --ok:#6ee7a0; --bad:#f08080; --bad-s:#1e0a0a;
    --sh:none; --shl:0 14px 44px rgba(0,0,0,.5);
  }

body{margin:0;background:var(--bg);color:var(--ink);
  font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,sans-serif;font-size:14.5px;line-height:1.55;
  font-variant-numeric:tabular-nums;-webkit-font-smoothing:antialiased}
.wrap{max-width:1200px;margin:0 auto;padding:30px 22px 72px}

/* ── encabezado ── */
.mast{display:flex;align-items:flex-end;gap:16px;flex-wrap:wrap;padding-bottom:16px}
h1{margin:0;font-size:25px;font-weight:700;letter-spacing:-.027em;line-height:1.1}
.mast p{margin:0;font-size:13px;color:var(--mut);flex:1 1 220px}
.note{padding:9px 13px;border:1px solid var(--line2);border-left:3px solid var(--qual);
  background:var(--qual-s);border-radius:0 6px 6px 0;font-size:12.5px;color:var(--ink);max-width:84ch}
.note b{font-weight:600}

/* ── pestañas de naturaleza ── */
.tabs{display:flex;flex-wrap:wrap;gap:2px;margin:20px 0 0;border-bottom:1px solid var(--line2)}
.tabs button{padding:9px 14px 10px;border:none;background:none;font:inherit;font-size:13px;
  font-weight:500;color:var(--mut);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px}
.tabs button:hover{color:var(--ink)}
.tabs button[aria-selected=true]{color:var(--ink);font-weight:650;border-bottom-color:var(--acc)}
.tabs button b{font-weight:inherit}
.tabs button i{font-style:normal;font-size:11px;color:var(--fnt);margin-left:6px}
.tabs button[aria-selected=true] i{color:var(--acc)}

/* ── controles ── */
.top{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:16px 0 11px}
input,select,button{font-family:inherit}
#q{flex:1 1 200px;min-width:0;padding:8px 12px;font:inherit;font-size:14px;color:var(--ink);
  border:1px solid var(--line2);border-radius:7px;background:var(--surf)}
#q::placeholder{color:var(--fnt)}
.top select{padding:8px 11px;font-size:13px;color:var(--mut);border:1px solid var(--line2);
  border-radius:7px;background:var(--surf);cursor:pointer}
.top select.on{border-color:var(--acc);color:var(--ink);font-weight:600}
#clr{padding:8px 12px;font-size:13px;font-weight:500;color:var(--mut);border:1px solid var(--line2);
  border-radius:7px;background:var(--surf);cursor:pointer;display:none}
#clr.on{display:block}
#clr:hover{color:var(--ink);border-color:var(--line2);background:var(--surf2)}
.cnt{font-size:12.5px;color:var(--mut);margin-left:auto}
.cnt b{color:var(--ink);font-weight:650}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
input:focus,select:focus{outline:2px solid var(--acc);outline-offset:-1px;border-color:transparent}

/* ── tabla ── */
.tbl{background:var(--surf);border:1px solid var(--line);border-radius:var(--r);
  overflow:hidden;box-shadow:var(--sh)}
.h1r,.h2r,.row{display:grid;grid-template-columns:var(--grid);gap:13px;align-items:center;padding:0 15px}
.h1r{padding-top:11px;padding-bottom:4px}
.h2r{padding-bottom:9px;border-bottom:1px solid var(--line2)}
.g2 .h1r,.g2 .h2r,.g2 .row{grid-template-columns:var(--grid2)}
.sb{display:flex;align-items:center;gap:4px;padding:0;border:none;background:none;font:inherit;
  font-size:11px;font-weight:650;color:var(--mut);cursor:pointer;text-align:left;line-height:1.2;
  letter-spacing:.01em}
.sb.r{justify-content:flex-end;width:100%}
.sb:hover{color:var(--ink)}
.sb[aria-sort]:not([aria-sort=none]){color:var(--acc)}
.sb i{font-style:normal;font-size:8px;opacity:.4}
.sb[aria-sort=ascending] i,.sb[aria-sort=descending] i{opacity:1}
.fs{width:100%;padding:4px 5px;font:inherit;font-size:11.5px;color:var(--mut);
  border:1px solid var(--line);border-radius:5px;background:var(--surf2);cursor:pointer}
.fs.on{border-color:var(--acc);color:var(--ink);background:var(--surf);font-weight:600}
.row{border-top:1px solid var(--line);cursor:pointer;transition:background .1s}
.row:hover{background:var(--surf2)}
.fam{font-size:12px;color:var(--mut);line-height:1.25}
.nm{font-weight:550;line-height:1.3;font-size:14px}
.sub{font-size:11px;color:var(--fnt);margin-top:1px;line-height:1.3}
.rev{display:inline-block;font-size:9.5px;font-weight:650;color:var(--bad);background:var(--bad-s);
  border:1px solid rgba(166,58,34,.2);border-radius:4px;padding:0 5px;vertical-align:1px;margin-left:5px}
.hh{text-align:right;line-height:1}
.hh b{font-size:17px;font-weight:700;letter-spacing:-.025em}
.hh u{display:block;text-decoration:none;font-size:10px;color:var(--fnt);margin-top:3px;line-height:1.3}
.hh.d b{font-size:15px;font-weight:600;color:var(--mut)}
.hh.z b{font-weight:400;color:var(--line2)}
.ramp{display:flex;height:7px;border-radius:99px;overflow:hidden;background:var(--line)}
.ramp i{display:block}
.car{color:var(--fnt);text-align:right;font-size:15px}
.zero{padding:26px 15px;color:var(--fnt);font-size:13.5px}
.sw{display:flex;border:1px solid var(--line2);border-radius:6px;overflow:hidden;background:var(--surf2)}
.sw button{flex:1;min-width:0;padding:4px 3px;border:none;border-left:1px solid var(--line2);
  background:none;font:inherit;font-size:10.5px;font-weight:600;color:var(--mut);cursor:pointer;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.35}
.sw button:first-child{border-left:none}
.sw button:hover{color:var(--ink);background:var(--surf)}
.sw button[aria-pressed=true]{background:var(--acc);color:#fff;border-left-color:var(--acc)}
.dash{font-size:11.5px;color:var(--line2)}
.lgd{display:flex;flex-wrap:wrap;gap:7px 16px;margin-top:14px;font-size:11.5px;color:var(--mut)}
.lgd div{display:flex;align-items:center;gap:5px}
.lgd s{text-decoration:none;width:9px;height:9px;border-radius:2px}
.foot{margin-top:14px;font-size:12px;color:var(--fnt);max-width:84ch;line-height:1.5}

/* ── modal ── */
.bk{position:fixed;inset:0;background:rgba(14,17,24,.55);display:none;align-items:flex-start;
  justify-content:center;padding:26px 18px;overflow-y:auto;z-index:50;backdrop-filter:blur(2px)}
.bk.on{display:flex}
.md{background:var(--surf);border-radius:12px;max-width:700px;width:100%;box-shadow:var(--shl);
  overflow:hidden;position:relative}
.mh{padding:20px 22px 0;position:relative}
.mh .eb{font-size:11.5px;color:var(--mut);font-weight:500}
.mh h3{margin:5px 0 3px;font-size:21px;font-weight:700;letter-spacing:-.024em;line-height:1.2;padding-right:40px}
.mh .mt{font-size:12px;color:var(--fnt)}
.xb{position:absolute;top:16px;right:16px;width:30px;height:30px;border-radius:7px;
  border:1px solid var(--line2);background:var(--surf);color:var(--mut);font:inherit;font-size:14px;
  cursor:pointer;line-height:1}
.xb:hover{background:var(--surf2);color:var(--ink)}
.csw{margin-top:13px;width:fit-content;max-width:100%}
.mtabs{display:flex;gap:2px;padding:0 22px;margin-top:16px;border-bottom:1px solid var(--line2)}
.mtabs button{padding:8px 15px 9px;border:none;background:none;font:inherit;font-size:13px;
  font-weight:550;color:var(--mut);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px}
.mtabs button:hover{color:var(--ink)}
.mtabs button[aria-selected=true]{color:var(--acc);font-weight:650;border-bottom-color:var(--acc)}
.mtabs button:disabled{color:var(--line2);cursor:default}
.sec{padding:18px 22px;border-top:1px solid var(--line)}
.sec:first-child{border-top:none}
.sec h4{margin:0 0 8px;font-size:11px;font-weight:650;color:var(--mut);letter-spacing:.012em}
.sec p{margin:0;font-size:13.5px;line-height:1.55;max-width:66ch;color:var(--ink)}
.sec p.e{color:var(--fnt)}
.warn{margin:0 22px;padding:10px 12px;background:var(--bad-s);border-left:3px solid var(--bad);
  border-radius:0 6px 6px 0;font-size:12px;color:var(--ink)}
.warn b{font-weight:650}
.warn ul{margin:3px 0 0;padding-left:16px}

/* lectura de instrumento */
.gauge{display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap}
.gv{display:flex;align-items:baseline;gap:5px}
.gv b{font-size:44px;font-weight:700;letter-spacing:-.04em;line-height:.92}
.gv span{font-size:15px;font-weight:600;color:var(--mut)}
.gv.pr b{color:var(--acc)}
.gd{padding-bottom:5px;font-size:12.5px;line-height:1.35}
.gd b{display:block;font-weight:650;color:var(--ok)}
.gd s{text-decoration:none;color:var(--fnt);font-size:11.5px}
.gmeta{margin-top:8px;font-size:11.5px;color:var(--fnt)}
.gramp{margin-top:11px;height:9px;border-radius:99px;overflow:hidden;background:var(--line);display:flex}
.gramp i{display:block}

/* eficiencia */
.ef{margin-top:15px;border:1px solid var(--line);border-radius:8px;background:var(--surf2);overflow:hidden}
.efh{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:8px 11px}
.eft{display:flex;align-items:center;gap:5px;padding:0;border:none;background:none;font:inherit;
  font-size:11.5px;font-weight:650;color:var(--mut);cursor:pointer}
.eft:hover{color:var(--ink)}
.eft i{font-style:normal;font-size:9px;transition:transform .14s}
.eft[aria-expanded=true] i{transform:rotate(90deg)}
.ehz{display:flex;gap:4px;margin-left:auto}
.ehz button{padding:3px 10px;border:1px solid var(--line2);border-radius:99px;background:var(--surf);
  font:inherit;font-size:11.5px;font-weight:600;color:var(--mut);cursor:pointer}
.ehz button:hover:not(:disabled){border-color:var(--acc);color:var(--acc)}
.ehz button[aria-pressed=true]{background:var(--acc);border-color:var(--acc);color:#fff}
.ehz button:disabled{color:var(--line2);border-color:var(--line);cursor:default}
.efb{padding:0 11px 11px;display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
.efc{background:var(--surf);border:1px solid var(--line);border-radius:7px;padding:8px 10px}
.efc label{display:block;font-size:10px;font-weight:650;color:var(--fnt);margin-bottom:2px}
.efi{display:flex;align-items:baseline;gap:3px}
.efi input{width:42px;padding:1px 0;border:none;border-bottom:1.5px solid var(--line2);background:none;
  font:inherit;font-size:19px;font-weight:700;color:var(--ink);letter-spacing:-.025em;
  -moz-appearance:textfield}
.efi input::-webkit-outer-spin-button,.efi input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.efi input:focus{outline:none;border-bottom-color:var(--acc)}
.efi input::placeholder{color:var(--line2);font-weight:400}
.efi u{text-decoration:none;font-size:12px;color:var(--fnt);font-weight:650}
.efr{font-size:11px;color:var(--mut);margin-top:2px}

/* rejilla rol x nivel */
.rgw{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:0 -2px;padding:0 2px}
.rg{width:100%;border-collapse:separate;border-spacing:0;font-size:12.5px;min-width:540px}
.rg th{font-size:10px;font-weight:650;color:var(--mut);padding:0 4px 6px;text-align:center;
  border-bottom:1px solid var(--line2)}
.rg th.rl{text-align:left;min-width:146px;padding-left:0}
.rg th.tt{border-left:1px solid var(--line2);padding-left:8px}
.rg th s{text-decoration:none;display:block;width:100%;height:3px;border-radius:99px;margin-bottom:4px}
.rg td{padding:0;border-bottom:1px solid var(--line);text-align:center}
.rg td.rl{text-align:left;padding:5px 8px 5px 0;font-weight:500;font-size:12px;line-height:1.25}
.rg td.tt{border-left:1px solid var(--line2);font-weight:700;padding:5px 8px;font-size:12.5px}
.rg input{width:100%;min-width:44px;padding:6px 2px;border:none;background:none;font:inherit;
  font-size:12.5px;text-align:center;color:var(--ink);-moz-appearance:textfield;border-radius:4px}
.rg input::-webkit-outer-spin-button,.rg input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.rg input:hover{background:var(--acc-s)}
.rg input:focus{outline:2px solid var(--acc);outline-offset:-2px;background:var(--surf)}
.rg tr.cp td{background:var(--surf2);font-weight:650;padding:5px 4px;border-top:1px solid var(--line2)}
.rg tr.or td{background:var(--surf2);color:var(--mut);padding:5px 4px;font-size:11.5px;border-bottom:none}
.rg tr.or td.rl,.rg tr.cp td.rl{font-size:10.5px;color:var(--mut);font-weight:600}
.na{color:var(--line2)}
.gn{font-size:11.5px;color:var(--fnt);margin-top:8px;line-height:1.45;max-width:72ch}
.gn.ok{color:var(--ok);font-weight:550}
.gn.ko{color:var(--bad);font-weight:550}

/* proceso */
.pb{display:flex;align-items:center;gap:11px;width:100%;padding:11px 13px;border:1px solid var(--acc);
  border-radius:8px;background:var(--acc);font:inherit;font-size:13.5px;font-weight:650;color:#fff;
  cursor:pointer;text-align:left}
.pb:hover{filter:brightness(1.08)}
.pb u{text-decoration:none;font-size:11.5px;font-weight:400;opacity:.8;margin-left:auto;white-space:nowrap}
.pe{padding:11px 13px;border:1px dashed var(--line2);border-radius:8px;font-size:12.5px;
  color:var(--fnt);line-height:1.45;display:flex;gap:11px;align-items:center;flex-wrap:wrap}
.pe button{padding:5px 11px;border:1px solid var(--acc);border-radius:7px;background:var(--surf);
  font:inherit;font-size:12px;font-weight:650;color:var(--acc);cursor:pointer;white-space:nowrap}
.pe button:hover{background:var(--acc-s)}

/* barra de guardado */
.sv{position:sticky;bottom:0;display:flex;align-items:center;gap:10px;padding:11px 22px;
  background:var(--surf);border-top:1px solid var(--line2);box-shadow:0 -6px 18px rgba(22,26,35,.07)}
.sv span{font-size:12px;color:var(--mut);flex:1}
.sv span b{color:var(--ink);font-weight:650}
.sv .pri{padding:7px 15px;border:1px solid var(--acc);border-radius:7px;background:var(--acc);
  font:inherit;font-size:12.5px;font-weight:650;color:#fff;cursor:pointer}
.sv .pri:hover{filter:brightness(1.08)}
.sv .pri:disabled{opacity:.45;cursor:default;filter:none}
.sv .gho{padding:7px 13px;border:1px solid var(--line2);border-radius:7px;background:var(--surf);
  font:inherit;font-size:12.5px;font-weight:550;color:var(--mut);cursor:pointer}
.sv .gho:hover{color:var(--ink);background:var(--surf2)}
.mn{padding:14px 22px 18px;font-size:11.5px;color:var(--fnt);line-height:1.5;border-top:1px solid var(--line)}
.mn b{color:var(--mut);font-weight:650}

/* ── canvas de proceso ── */
.cvbk{position:fixed;inset:0;background:rgba(14,17,24,.6);display:none;align-items:center;
  justify-content:center;padding:22px;z-index:70;backdrop-filter:blur(3px)}
.cvbk.on{display:flex}
.cvm{background:var(--surf);border-radius:14px;box-shadow:var(--shl);width:100%;max-width:1140px;
  height:min(86vh,880px);display:flex;flex-direction:column;overflow:hidden;position:relative}
.cvh{display:flex;align-items:center;gap:16px;flex-wrap:wrap;padding:14px 56px 14px 20px;
  border-bottom:1px solid var(--line);flex:none}
.cvh h3{margin:0;font-size:16px;font-weight:700;letter-spacing:-.022em;line-height:1.2}
.cvh .cs{font-size:11.5px;color:var(--mut)}
.cvtb{display:flex;border:1px solid var(--line2);border-radius:7px;overflow:hidden;margin-left:auto}
.cvtb button{padding:5px 13px;border:none;border-left:1px solid var(--line2);background:var(--surf2);
  font:inherit;font-size:12px;font-weight:600;color:var(--mut);cursor:pointer}
.cvtb button:first-child{border-left:none}
.cvtb button[aria-selected=true]{background:var(--acc);color:#fff;border-left-color:var(--acc)}

.cvb{flex:1;overflow:auto;position:relative;background:var(--bg);
  background-image:radial-gradient(circle,var(--line2) 1px,transparent 1px);
  background-size:22px 22px}
.cvb.t-pan{cursor:grab} .cvb.grab{cursor:grabbing}
.cvb.t-add{cursor:copy} .cvb.t-gate{cursor:crosshair}
.pane{position:relative}
.cw{position:absolute;top:0;left:0;transform-origin:0 0}
.cw svg{position:absolute;inset:0;pointer-events:none;overflow:visible}
.ed{fill:none;stroke:var(--line2);stroke-width:1.8}
.ed.gt{stroke:var(--gate);stroke-dasharray:6 4}
.ed.q{stroke:var(--qual);stroke-width:2.4}
.ed.gh{display:none;stroke:var(--acc);stroke-dasharray:4 4}

.nd{position:absolute;width:250px;background:var(--surf);border:1px solid var(--line2);
  border-radius:11px;z-index:2;box-shadow:var(--sh);cursor:grab}
.nd:hover{border-color:var(--acc)}
.nd.sel{border-color:var(--acc);box-shadow:0 0 0 3px var(--acc-s),var(--sh)}
.nd.drag{cursor:grabbing;z-index:9;box-shadow:var(--shl)}
.nd.op{z-index:6;cursor:default}
.nh2{display:flex;align-items:center;gap:8px;padding:9px 9px 9px 11px}
.nh2 s{text-decoration:none;width:19px;height:19px;border-radius:6px;background:var(--acc-s);
  color:var(--acc);font-size:10.5px;font-weight:700;display:grid;place-items:center;flex:none}
.nh2 b{font-size:13px;font-weight:600;line-height:1.3;flex:1;letter-spacing:-.008em;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nh2 em{font-style:normal;font-size:12px;font-weight:700;letter-spacing:-.02em;flex:none;color:var(--mut)}
.nx{width:22px;height:22px;flex:none;border:none;border-radius:6px;background:none;color:var(--fnt);
  cursor:pointer;display:grid;place-items:center;padding:0}
.nx:hover{background:var(--surf2);color:var(--ink)}
.nx svg{transition:transform .15s}
.nx[aria-expanded=true] svg{transform:rotate(180deg)}
.nq{display:flex;flex-wrap:wrap;gap:4px;padding:0 11px 10px}
.nqs{font-size:10px;font-weight:650;color:var(--acc);background:var(--acc-s);border-radius:4px;padding:1px 6px}
.nqc{font-size:10px;font-weight:600;color:var(--mut);background:var(--surf2);
  border:1px solid var(--line);border-radius:4px;padding:1px 6px}
.nqc.mo{color:var(--fnt)}
.nb{border-top:1px solid var(--line);padding:11px;display:flex;flex-direction:column;gap:9px}
.nf{display:block}
.nf i{display:block;font-style:normal;font-size:10px;font-weight:650;color:var(--mut);margin-bottom:3px}
.nf input,.nf textarea{width:100%;padding:6px 8px;border:1px solid var(--line2);border-radius:6px;
  background:var(--surf2);font:inherit;font-size:12.5px;color:var(--ink);resize:vertical}
.nf textarea{line-height:1.45;min-height:56px}
.nf input:focus,.nf textarea:focus{background:var(--surf)}
