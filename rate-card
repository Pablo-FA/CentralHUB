  var m={}; x.roles.forEach(function(r){ m[r]={}; LVL.forEach(function(l){m[r][l]=null}) });
  return {roles:m,eff:{e6:null,e1:null,e2:null}};
}
function defRec(x){
  var m=blank(x), d=blank(x);
  m.desc=null; m.asm=null; d.desc=null; d.asm=null;
  return {m:m,d:d,proc:x.proc?clone(x.proc):null,meta:{by:null,approver:null,at:null}};
}
function rec(x){
  var s=ED[x.id];
  if(!s)return defRec(x);
  var d=defRec(x);
  ["m","d"].forEach(function(b){
    if(!s[b])return;
    if(s[b].eff)d[b].eff=Object.assign(d[b].eff,s[b].eff);
    if(s[b].desc!=null)d[b].desc=s[b].desc;
    if(s[b].asm!=null)d[b].asm=s[b].asm;
    if(s[b].roles)for(var r in s[b].roles) if(d[b].roles[r])
      LVL.forEach(function(l){ if(s[b].roles[r][l]!=null)d[b].roles[r][l]=s[b].roles[r][l] });
  });
  if(s.proc)d.proc=clone(s.proc);
  if(s.meta)d.meta=Object.assign(d.meta,s.meta);
  return d;
}

