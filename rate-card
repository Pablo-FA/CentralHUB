}
function drawEdges(){
  var g=pg(), gEl=$("cwg"), cw=$("cw"); if(!gEl||!cw)return;
  [].slice.call(cw.querySelectorAll(".gb")).forEach(function(b){b.parentNode.removeChild(b)});
  var p="",bd="";
  g.edges.forEach(function(e,k){
    var a=nById(e.f), b=nById(e.t); if(!a||!b)return;
    var x1=a.px+NWC, y1=a.py+nodeH(a)/2, x2=b.px, y2=b.py+nodeH(b)/2, m=(x1+x2)/2;
    p+="<path d='M"+x1+" "+y1+" C"+(x1+40)+" "+y1+" "+m+" "+y2+" "+x2+" "+y2+
      "' class='ed"+(e.g==="quality"?" q":e.g==="gate"?" gt":"")+"' marker-end='url(#ar)'/>";
    bd+="<button class='gb "+(e.g==="quality"?"q":e.g==="gate"?"gt":"no")+(SELE===k?" on":"")+
      "' style='left:"+(m-13)+"px;top:"+((y1+y2)/2-12)+"px' data-edge='"+k+"' title='"+
      esc(e.lab||"Sin gate")+"'>"+(e.g?(e.g==="quality"?"Q":"G"):"/")+"</button>";
  });
  gEl.innerHTML=p; cw.insertAdjacentHTML("beforeend",bd);
}

/* ── pastilla de herramientas ── */
function bar(){
  var g=pg(), tot=pgHrs();
  var sum=g.nodes.reduce(function(a,n){return a+(n.h||0)},0);
  var d=Math.round((sum-tot)*100)/100;
  var cls=g.nodes.length?(Math.abs(d)<0.01?"bal ok":"bal ko"):"bal";
  var txt=g.nodes.length
    ? (Math.abs(d)<0.01?"Cuadra · <b>"+f(sum)+" h</b>":"<b>"+f(sum)+" h</b> vs "+f(tot)+" h ("+(d>0?"+":"")+f(d)+")")
    : "Sin fases · tarifario "+f(tot)+" h";
  function tb(k,lab,icn){
    return "<button data-tool='"+k+"' class='"+(TOOL===k?"on":"")+"' title='"+lab+"' aria-label='"+lab+
      "' aria-pressed='"+(TOOL===k)+"'>"+ic(icn)+"</button>";
  }
  $("pill").innerHTML=
    tb("sel","Seleccionar","sel")+tb("pan","Panear","pan")+
    "<span class='sep'></span>"+
    "<span class='zg'>"+ic("zoom",15)+
      "<button data-z='-1' aria-label='Alejar'"+(ZI<=0?" disabled":"")+">−</button>"+
      "<b data-z='0' role='button' title='Volver al 100 %'>"+Math.round(Z()*100)+" %</b>"+
      "<button data-z='1' aria-label='Acercar'"+(ZI>=ZS.length-1?" disabled":"")+">+</button></span>"+
    "<span class='sep'></span>"+
    tb("add","Nueva fase","add")+tb("gate","Nuevo gate","gate")+
    "<span class='sep'></span>"+
    "<span class='"+cls+"'>"+txt+"</span>"+
    "<button class='pr' id='cvsave'"+(dirty()?"":" disabled")+">Guardar</button>";
  $("hint").textContent=
    TOOL==="pan"?"Arrastra el lienzo para moverte."
    :TOOL==="add"?"Pulsa en el lienzo para colocar una fase."
    :TOOL==="gate"?"Pulsa una conexión para poner o quitar su gate."
    :"Arrastra el punto del borde derecho de una fase para conectarla con otra.";
}

